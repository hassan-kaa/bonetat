# Copy this file to .env and fill in your values
# cp .env.example .env

# ──────────────────────────────────────────────
# Database (PostgreSQL)
# Local:    postgresql://postgres:password@localhost:5432/bonetat
# Supabase: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# Neon:     postgresql://[user]:[password]@[host]/bonetat?sslmode=require
# ──────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/bonetat"

# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ──────────────────────────────────────────────
# SMS Provider (for production OTP)
# Currently in MOCK mode — OTP is logged to console
# To enable real SMS, implement sendOtp() in src/lib/auth.ts
# Options: Twilio, Infobip, local Tunisian providers
# ──────────────────────────────────────────────
# SMS_PROVIDER_API_KEY=""
# SMS_SENDER_ID="BONETAT"

# ──────────────────────────────────────────────
# Image storage (catalog + unit photos), Cloudflare R2 behind a CDN domain
# Public base URL the browser loads images from, no trailing slash.
# Leave everything unset locally: files go to public/media and are served at /media.
# ──────────────────────────────────────────────
# STORAGE_DRIVER="r2"
# NEXT_PUBLIC_IMAGE_BASE_URL="https://img.bonetat.tn"
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="bonetat-images"

# ──────────────────────────────────────────────
# Icecat (catalog photos). Your Open Icecat username, from "My profile" on icecat.biz.
# Unset = Icecat's public demo account: fine for development, not for production.
# ──────────────────────────────────────────────
# ICECAT_USERNAME=""
# ICECAT_PASSWORD=""        # icecat.biz login, needed to download the product index
# ICECAT_API_TOKEN=""
# ICECAT_CONTENT_KEY=""

# ──────────────────────────────────────────────
# Smart listing (stores paste their post, Claude Haiku 5.5 fills the form)
# Key from console.anthropic.com. About 0.002 DT per analysed post.
# ──────────────────────────────────────────────
# ANTHROPIC_API_KEY=""

# ──────────────────────────────────────────────
# Payment gateways (phase 2 — stub for now)
# ──────────────────────────────────────────────
# FLOUCI_APP_TOKEN=""
# FLOUCI_APP_SECRET=""
# KONNECT_API_KEY=""
