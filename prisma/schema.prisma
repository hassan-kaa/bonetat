generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  /// pg_trgm: typo-tolerant search on the reference catalog ("elitebok 8 g1i" still finds it)
  extensions = [pg_trgm]
}

// ─────────────────────────────────────────────────────────────────────
// Catalog model (v3, Oct 2026)
//
//   Product  "iPhone 11 Pro"             one page, owned by Bonétat
//   Variant  "256 Go, Vert nuit"         what the device IS (storage, color…)
//   Finish   "Vert nuit" on iPhone 11 Pro  a color as sold, owns the catalog photos
//   Offer    one physical unit            condition, battery, price, unit photos
//
// Buyers never see which partner owns an offer: the cheapest ACTIVE offer
// for the chosen variant + grade wins, ties go to the best quality score.
// ─────────────────────────────────────────────────────────────────────

enum Role {
  BUYER
  VENDOR
  ADMIN
}

enum VendorStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum ConditionGrade {
  COMME_NEUF
  TRES_BON
  BON
  CORRECT
}

enum DeviceKind {
  PHONE
  TABLET
  LAPTOP
  WATCH
  CONSOLE
  OTHER
}

enum OfferStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  INACTIVE
  REJECTED
  /// The unit is in an order. Back to ACTIVE if that order is cancelled.
  SOLD
}

/// Coarse color, shared across brands: drives the "Couleur" filter and
/// keeps the buyer's color when switching between sibling models.
enum ProductStatus {
  ACTIVE
  /// Created by a store, live, waiting for admin to confirm, merge or correct
  PROVISIONAL
  /// Duplicate folded into another product (mergedIntoId); its URL redirects there
  MERGED
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ColorFamily {
  BLACK
  WHITE
  GREY
  SILVER
  GOLD
  BLUE
  GREEN
  PURPLE
  PINK
  RED
  YELLOW
  ORANGE
  OTHER
}

enum ImageAngle {
  FRONT
  BACK
  SIDE
  DETAIL
}

enum ImageSource {
  ICECAT
  /// The brand's own website or store (apple.com…): official renders, one per color
  BRAND_SITE
  /// A Tunisian retailer's listing (tunisianet.com.tn): kept apart so it can be withdrawn in one go
  RETAILER
  PRESS_KIT
  OWN_SHOOT
  OTHER
}

enum ImageStatus {
  DRAFT
  APPROVED
  ARCHIVED
  /// Taken down by the admin: never shown, its source never re-imported, its file deleted after a grace period
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  DISPUTED
}

enum FulfillmentStatus {
  PENDING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  FLOUCI
  KONNECT
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
}

enum Locale {
  FR
  AR
}

model User {
  id             String   @id @default(cuid())
  phone          String   @unique
  name           String?
  email          String?
  role           Role     @default(BUYER)
  locale         Locale   @default(FR)
  notifySms      Boolean  @default(true)
  notifyWhatsapp Boolean  @default(true)
  notifyPromos   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vendor    Vendor?
  orders    Order[]
  reviews   Review[]
  sessions  Session[]
  addresses Address[]
  favorites Favorite[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("otp_codes")
}

/// A buyer's saved delivery address
model Address {
  id          String   @id @default(cuid())
  userId      String
  label       String
  fullName    String
  phone       String
  governorate String
  delegation  String?
  line        String
  notes       String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

/// A partner workshop. Never shown to buyers — only to the partner and admins.
model Vendor {
  id            String       @id @default(cuid())
  userId        String       @unique
  storeName     String
  description   String?
  instagramUrl  String?
  status        VendorStatus @default(PENDING)
  /// Internal partner code shown on packing slips (e.g. TN-0142)
  partnerCode   String?      @unique
  rating        Float?
  reviewCount   Int          @default(0)
  /// 0–100, breaks price ties in the buy box
  qualityScore  Int          @default(90)
  legalName     String?
  taxId         String?
  rne           String?
  contactName   String?
  phone         String?
  pickupAddress String?
  pickupHours   String?
  rib           String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  offers     Offer[]
  orderItems OrderItem[]
  reviews    Review[]
  payouts    Payout[]

  @@map("vendors")
}

model Category {
  id       String     @id @default(cuid())
  nameFr   String
  slug     String     @unique
  kind     DeviceKind @default(PHONE)
  position Int        @default(0)
  tagline  String?
  icon     String?
  parentId String?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

/// Canonical product page in the Bonétat catalog (e.g. "iPhone 11 Pro").
model Product {
  id                String        @id @default(cuid())
  categoryId        String
  brand             String
  model             String
  /// Range inside the brand ("Vostro", "EliteBook", "Galaxy S"), picked from ProductLine
  line              String?
  /// What identifies the model inside its line ("15 3520", "8 G1i", "S23")
  modelNumber       String?
  /// "dell|vostro|15 3520": brand + line + model number, normalized. One product per key.
  canonicalKey      String        @unique
  status            ProductStatus @default(ACTIVE)
  mergedIntoId      String?
  /// Set when a store created the product from the publish flow
  createdByVendorId String?
  /// The reference (Icecat) entry it was created from, if any
  referenceId       String?
  /// Where the model came from: "seed", "curated", "icecat", "wikidata", "store"
  source            String        @default("seed")
  /// normalized brand + line + model, trigram-indexed: what stores search the catalog with
  searchText        String        @default("")
  slug              String        @unique
  kind              DeviceKind    @default(PHONE)
  /// Family shared by sibling products ("iphone-11" groups 11 / 11 Pro / 11 Pro Max)
  series            String?
  /// Short name shown in the model switcher ("11 Pro")
  seriesLabel       String?
  seriesOrder       Int           @default(0)
  /// Drawing hint for the illustration (number of rear cameras)
  cameraCount       Int?
  description       String
  /// Reference price of the equivalent NEW device
  newPriceMillimes  Int?
  specsJson         Json?
  releaseYear       Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  category        Category         @relation(fields: [categoryId], references: [id])
  finishes        Finish[]
  /// Official photos: per color (finishId set) or of the model whatever the color (finishId null, the "cover")
  images          CatalogImage[]
  variants        Variant[]
  specSuggestions SpecSuggestion[]

  @@index([brand])
  @@index([series])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("products")
}

/// Brands a store can pick from (never typed). Also the brand list the Icecat index is filtered on.
model Brand {
  id       String        @id @default(cuid())
  name     String        @unique
  slug     String        @unique
  position Int           @default(0)
  lines    ProductLine[]

  @@map("brands")
}

/// Ranges inside a brand ("EliteBook", "Vostro"). Stores pick one, or propose a new one (reviewed with the product).
model ProductLine {
  id       String      @id @default(cuid())
  brandId  String
  name     String
  slug     String
  kind     DeviceKind?
  /// false while a store-proposed line waits for review
  approved Boolean     @default(true)

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, slug])
  @@map("product_lines")
}

/// Icecat index rows for every brand on the Brand list. Search source for "C'est l'un de ces modèles ?", never shown to buyers.
model ReferenceProduct {
  id          String     @id @default(cuid())
  icecatId    Int        @unique
  brand       String
  modelName   String
  productCode String
  /// normalized brand + model name + product code
  searchText  String
  picWidth    Int        @default(0)
  /// From the Icecat category: lets a store pick a reference model in one click
  kind        DeviceKind

  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("reference_products")
}

/// A store's correction to a product's shared specs, applied only when admin accepts it
model SpecSuggestion {
  id        String           @id @default(cuid())
  productId String
  vendorId  String
  /// [{ label, from, to }]
  changes   Json
  status    SuggestionStatus @default(PENDING)
  createdAt DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("spec_suggestions")
}

/// Every smart-listing interpretation: cost tracking, rate limiting, prompt improvement
model ListingDraft {
  id           String   @id @default(cuid())
  vendorId     String
  /// "paste" | "link" | "screenshot"
  source       String
  input        String
  extracted    Json?
  offerId      String?
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime @default(now())

  @@index([vendorId, createdAt])
  @@map("listing_drafts")
}

/// A color as the manufacturer sells it, for one product ("Bleu alpin" on iPhone 13 Pro).
/// Catalog photos hang off the finish, never off a variant: 128 Go and 256 Go look the same.
model Finish {
  id          String      @id @default(cuid())
  productId   String
  /// Stable across products ("bleu-alpin"), used to keep the color when switching sibling models
  slug        String
  nameFr      String
  nameAr      String?
  hex         String
  family      ColorFamily
  /// Other names for this color ("Sierra Blue"), used by image importers and sibling matching
  aliases     String[]    @default([])
  position    Int         @default(0)
  /// The Icecat product this color's catalog photos come from (one per color: every storage looks the same)
  icecatId    Int?
  /// How icecatId was chosen: "exact" (color name or alias), "family" (only color of that family), "manual"
  icecatMatch String?

  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  images           CatalogImage[]
  variants         Variant[]
  icecatCandidates IcecatCandidate[]

  @@unique([productId, slug])
  @@map("finishes")
}

/// An official photo of a model. Attached to the MODEL and, usually, one of its colors: every configuration
/// (storage, RAM, CPU) of that color shows it, since they look the same. finishId null = the model's photo
/// whatever the color (shown, flagged as indicative, when a color has none). Only APPROVED ones are shown.
model CatalogImage {
  id           String      @id @default(cuid())
  productId    String
  finishId     String?
  angle        ImageAngle
  position     Int         @default(0)
  /// Storage key without size suffix, named by content: catalog/<2 first chars of the hash>/<hash>.
  /// Not unique: the same file can illustrate two colors that really look the same.
  key          String
  width        Int
  height       Int
  /// Original resolution, so the review screen can warn about blurry upscales
  sourceWidth  Int?
  sourceHeight Int?
  /// Tiny base64 placeholder shown while the image loads
  blurDataUrl  String?
  /// Visual fingerprint (64-bit difference hash, hex): catches the same photo resized or re-encoded
  phash        String?
  source       ImageSource
  /// Where it came from (Icecat id, original URL), for audit
  sourceRef    String?
  /// The original file's URL: a rejected one is never downloaded again
  sourceUrl    String?
  status       ImageStatus @default(DRAFT)
  rejectReason String?
  rejectedAt   DateTime?
  createdAt    DateTime    @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  finish  Finish? @relation(fields: [finishId], references: [id], onDelete: Cascade)

  @@index([productId, finishId, status])
  @@index([finishId, status])
  @@index([key])
  @@index([sourceUrl])
  @@map("catalog_images")
}

/// One item fetched from an outside source (an Icecat product, a brand's product page…).
/// (source, externalId) is unique: re-running an import updates its row instead of adding a duplicate.
model SourceRecord {
  id         String   @id @default(cuid())
  /// "icecat", "apple", "samsung"…
  source     String
  /// The source's own id for the item
  externalId String
  url        String?
  productId  String?
  finishId   String?
  /// imported | skipped:refurbished | skipped:duplicate | no-match | rejected | error
  outcome    String
  detail     String?
  fetchedAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([source, externalId])
  @@index([productId])
  @@map("source_records")
}

/// Storage files waiting to be deleted (rejected photos, withdrawn offers, ended warranties).
/// A grace period lets a mistake be undone; the cleanup job (npm run media:cleanup) deletes them.
model PendingDeletion {
  id          String   @id @default(cuid())
  /// Storage key without size suffix: every width of it goes
  key         String
  reason      String
  deleteAfter DateTime
  createdAt   DateTime @default(now())

  @@index([deleteAfter])
  @@map("pending_deletions")
}

/// What the device IS: one combination of the product's spec axes.
/// Owned by Bonétat; partners attach offers to it.
model Variant {
  id               String  @id @default(cuid())
  productId        String
  storageGb        Int?
  ramGb            Int?
  finishId         String
  /// Free axis for what storage/RAM/color don't cover: "41 mm, GPS", "Wi-Fi + Cellular", "Édition digitale"
  option           String?
  /// Overrides Product.newPriceMillimes for this variant
  newPriceMillimes Int?
  position         Int     @default(0)
  /// "256|8|-|bleu-alpin", see variantSignature(). Postgres treats NULLs as distinct,
  /// so a unique index on the nullable axes alone would let duplicates through.
  signature        String

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  finish    Finish     @relation(fields: [finishId], references: [id])
  offers    Offer[]
  favorites Favorite[]

  @@unique([productId, signature])
  @@index([finishId])
  @@map("variants")
}

/// One physical unit a partner sells. No quantity: three identical phones are three offers.
model Offer {
  id                    String         @id @default(cuid())
  variantId             String
  vendorId              String
  conditionGrade        ConditionGrade
  /// Measured battery health in %
  batteryHealth         Int?
  imei                  String?
  warrantyMonths        Int            @default(12)
  priceMillimes         Int
  /// Set when the partner lowers the price, drives the "Prix en baisse" tag
  previousPriceMillimes Int?
  priceChangedAt        DateTime?
  sellerNote            String?
  status                OfferStatus    @default(PENDING_REVIEW)
  rejectionReason       String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  variant    Variant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  vendor     Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  photos     OfferPhoto[]

  @@index([variantId, status])
  @@index([vendorId, status])
  @@map("offers")
}

/// An Icecat product the sync found for a color but couldn't match with certainty.
/// Shown on the review screen so Kaa confirms the right one in one click.
model IcecatCandidate {
  id          String   @id @default(cuid())
  finishId    String
  icecatId    Int
  title       String
  /// Icecat's coarse color ("Noir") and marketing name ("Phantom Black")
  color       String?
  colorName   String?
  picWidth    Int?
  /// Icecat's main image URL, shown as a small preview in the admin only (never on the site)
  previewUrl  String?
  /// Reseller listing of a refurbished unit: often branded on the screen, check before using
  refurbished Boolean  @default(false)
  score       Int      @default(0)
  createdAt   DateTime @default(now())

  finish Finish @relation(fields: [finishId], references: [id], onDelete: Cascade)

  @@unique([finishId, icecatId])
  @@map("icecat_candidates")
}

/// Partner photo of the actual unit, shown when this offer is in the buy box.
model OfferPhoto {
  id        String   @id @default(cuid())
  offerId   String
  /// Storage key without size suffix: units/<offerId>/<hash> (one folder per offer, deleted with it)
  key       String   @unique
  width     Int
  height    Int
  position  Int      @default(0)
  createdAt DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@map("offer_photos")
}

model Favorite {
  id                 String   @id @default(cuid())
  userId             String
  variantId          String
  alertEnabled       Boolean  @default(false)
  alertPriceMillimes Int?
  /// Price when the buyer started following, to show the trend
  startPriceMillimes Int?
  createdAt          DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@map("favorites")
}

model Order {
  id                  String        @id @default(cuid())
  /// Human reference, e.g. BN-20418
  number              String        @unique
  buyerId             String
  status              OrderStatus   @default(PENDING)
  paymentMethod       PaymentMethod @default(COD)
  totalMillimes       Int
  shippingFeeMillimes Int           @default(0)
  shippingAddress     Json
  courier             String?
  notes               String?
  deliveredAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  buyer User        @relation(fields: [buyerId], references: [id])
  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id                 String            @id @default(cuid())
  orderId            String
  offerId            String
  vendorId           String
  priceMillimes      Int
  commissionMillimes Int               @default(0)
  /// Snapshots, so order history survives catalog edits
  title              String
  configLabel        String
  grade              ConditionGrade
  batteryHealth      Int?
  warrantyMonths     Int               @default(12)
  fulfillmentStatus  FulfillmentStatus @default(PENDING)
  shippedAt          DateTime?

  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offer  Offer   @relation(fields: [offerId], references: [id])
  vendor Vendor  @relation(fields: [vendorId], references: [id])
  review Review?

  @@index([vendorId])
  @@map("order_items")
}

model Review {
  id          String   @id @default(cuid())
  orderItemId String   @unique
  buyerId     String
  vendorId    String
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  buyer     User      @relation(fields: [buyerId], references: [id])
  vendor    Vendor    @relation(fields: [vendorId], references: [id])

  @@map("reviews")
}

model Payout {
  id                 String       @id @default(cuid())
  vendorId           String
  period             String
  grossMillimes      Int
  commissionMillimes Int
  netMillimes        Int
  status             PayoutStatus @default(PENDING)
  paidAt             DateTime?
  createdAt          DateTime     @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@map("payouts")
}

/// A message to one user: offer validated, correction asked, order placed / confirmed / shipped…
/// Shown live (toast) by the page they have open, without refreshing.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  href      String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, createdAt])
  @@map("notifications")
}
